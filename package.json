{
  "name": "salesforce-api-sdlc-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Spec-first SDLC automation on a Salesforce org's own generated OpenAPI spec",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "token": "node scripts/sf-token.mjs",
    "generate": "node scripts/generate-spec.mjs",
    "build": "node scripts/apply-overlay.mjs",
    "build-check": "node scripts/apply-overlay.mjs --check",
    "compat": "node scripts/compat-gate.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@pb33f/openapi-changes": "^0.2.7"
  }
}
